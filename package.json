{
  "name": "TaskManagementApp",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "postinstall": "patch-package",
    "start": "react-native start",
    "start:fresh": "npm run kill && react-native start --reset-cache",
    "kill": "lsof -ti tcp:8081 | xargs kill -9 2>/dev/null; exit 0",
    "android": "npm run android:dev",
    "android:dev": "react-native run-android --mode=devDebug --appId com.taskmanagementapp.dev",
    "android:staging": "react-native run-android --mode=stagingDebug --appId com.taskmanagementapp.staging",
    "android:prod": "react-native run-android --mode=productionDebug --appId com.taskmanagementapp",
    "android:build:dev": "cd android && ./gradlew assembleDevRelease",
    "android:build:prod": "cd android && ./gradlew assembleProductionRelease",
    "ios": "npm run ios:dev",
    "ios:dev": "react-native run-ios --scheme TaskManagementApp --mode Debug",
    "ios:staging": "react-native run-ios --scheme \"TaskManagementApp Staging\" --mode Debug-Staging",
    "ios:prod": "react-native run-ios --scheme \"TaskManagementApp Production\" --mode Debug-Production",
    "pods": "cd ios && bundle exec pod install",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@notifee/react-native": "^9.1.8",
    "@op-engineering/op-sqlite": "^18.1.1",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-firebase/app": "^26.2.0",
    "@react-native-firebase/auth": "^26.2.0",
    "@react-native-firebase/firestore": "^26.2.0",
    "@react-native-firebase/messaging": "^26.2.0",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.8",
    "@reduxjs/toolkit": "^2.12.0",
    "dayjs": "^1.11.23",
    "lodash": "^4.18.1",
    "react": "19.2.3",
    "react-native": "0.87.0",
    "react-native-config": "^1.6.1",
    "react-native-safe-area-context": "^5.9.1",
    "react-native-screens": "^4.27.0",
    "react-redux": "^9.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.0",
    "@react-native/eslint-config": "0.87.0",
    "@react-native/jest-preset": "0.87.0",
    "@react-native/metro-config": "0.87.0",
    "@react-native/typescript-config": "0.87.0",
    "@types/jest": "^29.5.13",
    "@types/lodash": "^4.17.25",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "patch-package": "^8.0.1",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
